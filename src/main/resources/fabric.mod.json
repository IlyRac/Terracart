{
	"schemaVersion": 1,
	"id": "terracart",
	"version": "${version}",
	"name": "Terracarts",
	"description": "Vanilla-friendly vehicles with smooth movement and physics, colors and model variants, loot tables and randomized stats, refuel and repair systems, collision and damage mechanics, custom HUD, sounds, and particle effects.",
	"authors": [
		"IlyRac"
	],
	"custom": {
		"modmenu": {
			"links": {
				"Every coffee fuels more features — thank you!": "https://ko-fi.com/ilyrac",
				"Source Code": "https://github.com/IlyRac/Terracart",
				"License": "https://github.com/IlyRac/Terracart/blob/main/LICENSE.md"
			},
			"update_checker": true
		}
	},
	"license": "IlyRac License",
	"icon": "assets/terracart/icon.png",
	"environment": "*",
	"entrypoints": {
		"fabric-datagen": [
			"com.ilyrac.terracart.client.TerracartDataGenerator"
		],
		"main": [
			"com.ilyrac.terracart.Terracart"
		],
		"client": [
			"com.ilyrac.terracart.client.TerracartClient"
		]
	},
	"mixins": [
		"terracart.mixins.json",
		{
			"config": "terracart.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.3",
		"java": ">=25",
		"fabric-api": "*"
	}
}