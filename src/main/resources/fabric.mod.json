{
	"schemaVersion": 1,
	"id": "terracart",
	"version": "${version}",
	"name": "Terracart",
	"description": "Vanilla-friendly drivable cart, smooth movement, colors, fuel & repairs, HUD, sounds & particles.",
	"authors": [
		"IlyRac"
	],
	"custom": {
		"modmenu": {
			"links": {
				"Enjoying the mod? Support me!": "https://ko-fi.com/ilyrac",
				"License": "https://github.com/IlyRac/Terracart/blob/main/LICENSE.md"
			},
			"update_checker": true
		}
	},
	"license": "IlyRac License",
	"icon": "assets/terracart/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.ilyrac.terracart.Terracart"
		],
		"client": [
			"com.ilyrac.terracart.client.TerracartClient"
		]
	},
	"mixins": [
		"terracart.mixins.json",
		{
			"config": "terracart.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.3",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}